{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "NTP",
  "x-format": "grid",
  "required": ["server"],
  "properties": {
    "enabled": {
      "x-format": "toggle",
      "type": "boolean"
    },
    "server": {
      "type": "string",
      "title": "Server",
      "x-grid": {
        "columns": 6
      }
    },
    "server_port": {
      "type": "integer",
      "title": "Port",
      "x-grid": {
        "columns": 6
      }
    },
    "interval": {
      "type": "string"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_dial"
    }
  ]
}
