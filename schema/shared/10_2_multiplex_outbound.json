{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "protocol": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["h2mux", "smux", "yamux"]
    },
    "max_connections": {
      "type": "integer"
    },
    "min_streams": {
      "type": "integer"
    },
    "max_streams": {
      "type": "integer"
    },
    "padding": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "brutal": {
      "$ref": "#/$defs/shared_brutal"
    }
  }
}