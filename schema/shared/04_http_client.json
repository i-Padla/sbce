{
  "type": "object",
  "x-enableCollapseToggle": true,
  "x-collapseToggleContent": "",
  "properties": {
    "engine": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["go", "apple"]
    },
    "version": {
      "type": "integer",
      "x-format": "radios-inline",
      "enum": [2, 1, 3]
    },
    "disable_version_fallback": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "headers": {
      "$ref": "#/$defs/shared_http_headers"
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_outbound"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_quic"
    },
    {
      "$ref": "#/$defs/shared_dial"
    }
  ]
}