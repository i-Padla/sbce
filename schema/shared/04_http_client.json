{
    "type": "object",
    "x-enableCollapseToggle": true,
    "x-collapseToggleContent": "",
    "properties": {
        "engine": {
            "type": "string",
            "enum": [
                "go",
                "apple"
            ]
        },
        "version": {
            "type": "integer",
            "enum": [
                2,
                1,
                3
            ]
        },
        "disable_version_fallback": {
            "type": "boolean",
            "x-format": "checkbox"
        },
        "headers": {
            "$ref": "#/$defs/shared_http_headers"
        },
        "tls": {
            "$ref": "#/$defs/shared_tls_outbound"
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/shared_http2"
        },
        {
            "$ref": "#/$defs/shared_dial"
        }
    ]
}