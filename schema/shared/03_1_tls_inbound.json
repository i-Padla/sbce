{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "x-enablePropertiesToggle": true,
  "x-propertiesToggleContent": "Toggle properties",
  "x-enableCollapseToggle": true,
  "x-collapseToggleContent": "",
  "default": { "enabled": true },
  "properties": {
    "enabled": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "server_name": {
      "type": "string"
    },
    "alpn": {
      "$ref": "#/$defs/string_or_array"
    },
    "min_version": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["", "1.0", "1.1", "1.2", "1.3"],
      "x-enumTitles": [
        "Empty (use default i.e. 1.0)",
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ]
    },
    "max_version": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["", "1.0", "1.1", "1.2", "1.3"],
      "x-enumTitles": [
        "Empty (use default i.e. 1.3)",
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ]
    },
    "cipher_suites": {
      "type": "array",
      "x-format": "table",
      "x-arrayAddContent": "Add",
      "x-arrayMove": false,
      "x-arrayDeleteContent": "",
      "x-arrayDeleteAll": true,
      "x-arrayDeleteAllContent": "Delete all",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "items": {
        "type": "string",
        "enum": [
          "TLS_RSA_WITH_AES_128_CBC_SHA",
          "TLS_RSA_WITH_AES_256_CBC_SHA",
          "TLS_RSA_WITH_AES_128_GCM_SHA256",
          "TLS_RSA_WITH_AES_256_GCM_SHA384",
          "TLS_AES_128_GCM_SHA256",
          "TLS_AES_256_GCM_SHA384",
          "TLS_CHACHA20_POLY1305_SHA256",
          "TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA",
          "TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA",
          "TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA",
          "TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA",
          "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256",
          "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384",
          "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256",
          "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384",
          "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256",
          "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256"
        ]
      }
    },
    "curve_preferences": {
      "type": "array",
      "x-format": "table",
      "x-arrayAddContent": "Add",
      "x-arrayMove": false,
      "x-arrayDeleteContent": "",
      "x-arrayDeleteAll": true,
      "x-arrayDeleteAllContent": "Delete all",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "items": {
        "type": "string",
        "enum": ["P256", "P384", "P521", "X25519", "X25519MLKEM768"]
      }
    },
    "certificate": {
      "$ref": "#/$defs/string_or_array"
    },
    "certificate_path": {
      "type": "string"
    },
    "client_authentication": {
      "type": "string"
    },
    "client_certificate": {
      "$ref": "#/$defs/string_or_array"
    },
    "client_certificate_path": {
      "$ref": "#/$defs/string_or_array"
    },
    "client_certificate_public_key_sha256": {
      "$ref": "#/$defs/string_or_array"
    },
    "key": {
      "$ref": "#/$defs/string_or_array"
    },
    "key_path": {
      "type": "string"
    },
    "kernel_tx": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "kernel_rx": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "handshake_timeout": {
      "type": "string",
      "description": "TLS handshake timeout, in golang's Duration format. `15s` is used by default."
    },
    "certificate_provider": {
      "x-switcherInput": "modal",
      "oneOf": [
        {
          "x-switcherTitle": "Tag only",
          "type": "string"
        },
        {
          "$ref": "#/$defs/certificate_providers_acme"
        },
        {
          "$ref": "#/$defs/certificate_providers_tailscale"
        },
        {
          "$ref": "#/$defs/certificate_providers_cloudflare_origin_ca"
        }
      ]
    },
    "ech": {
      "type": "object",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "properties": {
        "enabled": {
          "type": "boolean",
          "x-format": "toggle"
        },
        "key": {
          "$ref": "#/$defs/string_or_array"
        },
        "key_path": {
          "type": "string"
        },
        "pq_signature_schemes_enabled": {
          "type": "boolean",
          "x-format": "toggle",
          "x-propGroup": "depricated"
        },
        "dynamic_record_sizing_disabled": {
          "type": "boolean",
          "x-format": "toggle",
          "x-propGroup": "depricated"
        }
      }
    },
    "reality": {
      "type": "object",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "properties": {
        "enabled": {
          "type": "boolean",
          "x-format": "toggle"
        },
        "handshake": {
          "allOf": [
            {
              "type": "object",
              "x-enableCollapseToggle": true,
              "x-collapseToggleContent": "",
              "x-format": "grid",
              "properties": {
                "server": {
                  "type": "string",
                  "x-grid": {
                    "columns": 6
                  }
                },
                "server_port": {
                  "type": "integer",
                  "x-grid": {
                    "columns": 6
                  }
                }
              }
            },
            {
              "$ref": "#/$defs/shared_dial"
            }
          ]
        },
        "private_key": {
          "type": "string"
        },
        "short_id": {
          "$ref": "#/$defs/string_or_array"
        },
        "max_time_difference": {
          "type": "string"
        }
      }
    }
  }
}
