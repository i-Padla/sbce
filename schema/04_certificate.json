{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certificate",
  "type": "object",
  "properties": {
    "store": {
      "type": "string",
      "enum": [
        "system",
        "mozilla",
        "chrome",
        "none"
      ]
    },
    "certificate": {
      "$ref": "#/$defs/string_or_array"
    },
    "certificate_path": {
      "$ref": "#/$defs/string_or_array"
    },
    "certificate_directory_path": {
      "$ref": "#/$defs/string_or_array"
    }
  }
}