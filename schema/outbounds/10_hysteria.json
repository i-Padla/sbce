{
  "type": "object",
  "title": "Hysteria",
  "x-format": "grid",
  "required": [
    "type",
    "server",
    "server_port",
    "tls"
  ],
  "properties": {
    "type": {
      "x-propertyOrder": 10,
      "type": "string",
      "default": "hysteria",
      "const": "hysteria",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "x-propertyOrder": 20,
      "type": "string",
      "default": "hysteria-out",
      "x-grid": {
        "columns": 6
      }
    },
    "server": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "server_port": {
      "type": "integer",
      "x-grid": {
        "columns": 6
      }
    },
    "server_ports": {
      "$ref": "#/$defs/string_or_array"
    },
    "hop_interval": {
      "type": "string"
    },
    "up": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "up_mbps": {
      "type": "integer",
      "x-grid": {
        "columns": 6
      }
    },
    "down": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "down_mbps": {
      "type": "integer",
      "x-grid": {
        "columns": 6
      }
    },
    "obfs": {
      "type": "string"
    },
    "auth": {
      "type": "string"
    },
    "auth_str": {
      "type": "string"
    },
    "network": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["tcp", "udp"]
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_outbound"
    },
    "recv_window_conn": {
      "type": "integer",
      "x-propGroup": "depricated"
    },
    "recv_window": {
      "type": "integer",
      "x-propGroup": "depricated"
    },
    "disable_mtu_discovery": {
      "type": "boolean",
      "x-format": "toggle",
      "x-propGroup": "depricated"
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/shared_quic"
    },
    {
      "$ref": "#/$defs/shared_dial"
    }
  ]
}