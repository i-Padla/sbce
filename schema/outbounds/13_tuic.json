{
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-format": "grid",
  "required": ["type", "server", "server_port", "uuid", "tls"],
  "properties": {
    "type": {
      "type": "string",
      "default": "tuic",
      "const": "tuic",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "tuic-out",
      "x-grid": {
        "columns": 6
      }
    },
    "server": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "server_port": {
      "type": "integer",
      "x-grid": {
        "columns": 6
      }
    },
    "uuid": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "congestion_control": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["cubic", "new_reno", "bbr"]
    },
    "udp_relay_mode": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["native", "quic"]
    },
    "udp_over_stream": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "zero_rtt_handshake": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "heartbeat": {
      "type": "string"
    },
    "network": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["tcp", "udp"]
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_outbound"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_quic"
    },
    {
      "$ref": "#/$defs/shared_dial"
    }
  ]
}