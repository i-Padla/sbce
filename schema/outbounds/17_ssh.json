{
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-format": "grid",
  "required": ["type"],
  "properties": {
    "type": {
      "type": "string",
      "default": "ssh",
      "const": "ssh",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "ssh-out",
      "x-grid": {
        "columns": 6
      }
    },
    "server": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "server_port": {
      "type": "integer",
      "x-grid": {
        "columns": 6
      }
    },
    "user": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "password": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "private_key": {
      "type": "string"
    },
    "private_key_path": {
      "type": "string"
    },
    "private_key_passphrase": {
      "type": "string"
    },
    "host_key": {
      "$ref": "#/$defs/string_or_array"
    },
    "host_key_algorithms": {
      "$ref": "#/$defs/string_or_array"
    },
    "client_version": {
      "type": "string"
    },
    "cipher": {
      "$ref": "#/$defs/string_or_array"
    },
    "mac": {
      "$ref": "#/$defs/string_or_array"
    },
    "kex_algorithm": {
      "$ref": "#/$defs/string_or_array"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_dial"
    }
  ]
}
