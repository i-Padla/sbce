{
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-format": "grid",
  "required": ["type"],
  "properties": {
    "type": {
      "type": "string",
      "default": "tor",
      "const": "tor",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "tor-out",
      "x-grid": {
        "columns": 6
      }
    },
    "executable_path": {
      "type": "string"
    },
    "extra_args": {
      "$ref": "#/$defs/string_or_array"
    },
    "data_directory": {
      "type": "string"
    },
    "torrc": {
      "type": "object",
      "x-objectAdd": true,
      "x-addPropertyContent": "Add torrc options",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_dial"
    }
  ]
}
