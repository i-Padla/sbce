{
  "type": "object",
  "title": "VLESS",
  "x-format": "grid",
  "required": ["type", "server", "server_port", "uuid"],
  "properties": {
    "type": {
      "type": "string",
      "default": "vless",
      "const": "vless",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "vless-out",
      "x-grid": {
        "columns": 6
      }
    },
    "server": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "server_port": {
      "type": "integer",
      "x-grid": {
        "columns": 6
      }
    },
    "uuid": {
      "type": "string",
      "x-inputAttributes": {
        "placeholder": "bf000d23-0752-40b4-affe-68f7707a9661"
      }
    },
    "flow": {
      "type": "string",
      "default": "xtls-rprx-vision"
    },
    "network": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["tcp", "udp"]
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_outbound"
    },
    "packet_encoding": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["", "packetaddr", "xudp"],
      "x-enumTitles": ["disabled", "packetaddr", "xudp"]
    },
    "multiplex": {
      "$ref": "#/$defs/shared_multiplex_outbound"
    },
    "transport": {
      "$ref": "#/$defs/shared_v2ray_transport"
    }
  },
  "x-mergeAllOf": true,
  "AllOf": [{ "$ref": "#/$defs/shared_dial" }]
}
