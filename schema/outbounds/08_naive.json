{
  "type": "object",
  "title": "Naive",
  "x-format": "grid",
  "required": ["type", "server", "server_port", "tls"],
  "properties": {
    "type": {
      "x-propertyOrder": 10,
      "type": "string",
      "default": "naive",
      "const": "naive",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "x-propertyOrder": 20,
      "type": "string",
      "default": "naive-out",
      "x-grid": {
        "columns": 6
      }
    },
    "server": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "server_port": {
      "type": "integer",
      "x-grid": {
        "columns": 6
      }
    },
    "username": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "insecure_concurrency": {
      "type": "integer"
    },
    "extra_headers": {
      "$ref": "#/$defs/shared_http_headers"
    },
    "udp_over_tcp": {
      "$ref": "#/$defs/shared_udp_over_tcp"
    },
    "quic": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "quic_congestion_control": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["", "bbr", "bbr2", "cubic", "reno"],
      "x-enumTitles": ["Default (BBR)", "BBR", "BBRv2", "CUBIC", "New Reno"]
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_outbound"
    }
  },
  "$ref": "#/$defs/shared_dial"
}
