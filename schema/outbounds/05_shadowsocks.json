{
  "type": "object",
  "title": "Shadowsocks",
  "x-format": "grid",
  "required": [
    "type",
    "server",
    "server_port",
    "method",
    "password"
  ],
  "properties": {
    "type": {
      "type": "string",
      "default": "shadowsocks",
      "const": "shadowsocks",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "ss-out",
      "x-grid": {
        "columns": 6
      }
    },
    "server": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "server_port": {
      "type": "integer",
      "x-grid": {
        "columns": 6
      }
    },
    "method": {
      "type": "string",
      "enum": [
        "2022-blake3-aes-128-gcm",
        "2022-blake3-aes-256-gcm",
        "2022-blake3-chacha20-poly1305",
        "none",
        "aes-128-gcm",
        "aes-192-gcm",
        "aes-256-gcm",
        "chacha20-ietf-poly1305",
        "xchacha20-ietf-poly1305"
      ]
    },
    "password": {
      "description": "Password.",
      "type": "string"
    },
    "udp_over_tcp": {
      "$ref": "#/$defs/shared_udp_over_tcp"
    },
    "plugin": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["obfs-local", "v2ray-plugin"]
    },
    "plugin_opts": {
      "type": "string"
    },
    "network": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["tcp", "udp"]
    },
    "multiplex": {
      "$ref": "#/$defs/shared_multiplex_outbound"
    }
  },
  "$ref": "#/$defs/shared_dial"
}