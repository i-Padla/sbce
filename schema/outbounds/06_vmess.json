{
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-format": "grid",
  "required": ["type", "server", "server_port", "uuid"],
  "properties": {
    "type": {
      "type": "string",
      "default": "vmess",
      "const": "vmess",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "vmess-out",
      "x-grid": {
        "columns": 6
      }
    },
    "server": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "server_port": {
      "type": "integer",
      "x-grid": {
        "columns": 6
      }
    },
    "uuid": {
      "type": "string"
    },
    "security": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": [
        "auto",
        "none",
        "zero",
        "aes-128-gcm",
        "chacha20-poly1305",
        "aes-128-ctr"
      ]
    },
    "alter_id": {
      "type": "integer"
    },
    "global_padding": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "authenticated_length": {
      "type": "boolean",
      "x-format": "toggle",
      "default": true
    },
    "network": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["tcp", "udp"]
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_outbound"
    },
    "packet_encoding": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["", "packetaddr", "xudp"],
      "x-enumTitles": ["disabled", "packetaddr", "xudp"]
    },
    "transport": {
      "$ref": "#/$defs/shared_v2ray_transport"
    },
    "multiplex": {
      "$ref": "#/$defs/shared_multiplex_outbound"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_dial"
    }
  ]
}
