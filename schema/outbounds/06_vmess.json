      "type": "string",
      "default": "vmess-out",
      "x-grid": {
        "columns": 6
      }
    },
    "server": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "server_port": {
      "type": "integer",
      "x-grid": {
        "columns": 6
      }
    },
    "uuid": {
      "type": "string"
    },
    "security": {
      "type": "string",
      "enum": [
        "auto",
        "none",
        "zero",
        "aes-128-gcm",
        "chacha20-poly1305",
        "aes-128-ctr"
      ]
    },
    "alter_id": {
      "type": "integer"
    },
    "global_padding": {
      "type": "boolean",
