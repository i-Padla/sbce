{
  "type": "object",
  "title": "SOCKS",
  "x-format": "grid",
  "required": ["type", "server", "server_port"],
  "properties": {
    "type": {
      "type": "string",
      "default": "socks",
      "const": "socks",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "socks-out",
      "x-grid": {
        "columns": 6
      }
    },
    "server": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "server_port": {
      "type": "integer",
      "x-grid": {
        "columns": 6
      }
    },
    "version": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["5", "4", "4a"],
      "x-grid": {
        "columns": 6
      }
    },
    "username": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "password": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "network": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["tcp", "udp"],
      "x-grid": {
        "columns": 6
      }
    },
    "udp_over_tcp": {
      "$ref": "#/$defs/shared_udp_over_tcp"
    }
  },
  "$ref": "#/$defs/shared_dial"
}
