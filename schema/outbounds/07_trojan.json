{
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-format": "grid",
  "required": ["type", "server", "server_port", "password"],
  "properties": {
    "type": {
      "type": "string",
      "default": "trojan",
      "const": "trojan",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "trojan-out",
      "x-grid": {
        "columns": 6
      }
    },
    "server": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "server_port": {
      "type": "integer",
      "x-grid": {
        "columns": 6
      }
    },
    "password": {
      "type": "string"
    },
    "network": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["tcp", "udp"]
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_outbound"
    },
    "transport": {
      "$ref": "#/$defs/shared_v2ray_transport"
    },
    "multiplex": {
      "$ref": "#/$defs/shared_multiplex_outbound"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_dial"
    }
  ]
}
