{
  "type": "array",
  "title": "Outbounds",
  "x-format": "nav-horizontal",
  "x-arrayAddContent": "Add",
  "x-arrayMove": false,
  "x-arrayDeleteContent": "",
  "x-arrayDeleteAll": true,
  "x-arrayDeleteAllContent": "Delete all",
  "x-titleTemplate": "#{{ i1 }} {{ value.tag }} ({{ value.type }})",
  "items": {
    "x-switcherInput": "select-inline",
    "x-discriminator": "type",
    "oneOf": [
      { "x-switcherTitle": "Direct", "$ref": "#/$defs/outbounds_direct" },
      { "x-switcherTitle": "Block", "$ref": "#/$defs/outbounds_block" },
      { "x-switcherTitle": "SOCKS", "$ref": "#/$defs/outbounds_socks" },
      { "x-switcherTitle": "HTTP", "$ref": "#/$defs/outbounds_http" },
      {
        "x-switcherTitle": "Shadowsocks",
        "$ref": "#/$defs/outbounds_shadowsocks"
      },
      { "x-switcherTitle": "VMess", "$ref": "#/$defs/outbounds_vmess" },
      { "x-switcherTitle": "Trojan", "$ref": "#/$defs/outbounds_trojan" },
      { "x-switcherTitle": "Naive", "$ref": "#/$defs/outbounds_naive" },
      { "x-switcherTitle": "Hysteria", "$ref": "#/$defs/outbounds_hysteria" },
      { "x-switcherTitle": "ShadowTLS", "$ref": "#/$defs/outbounds_shadowtls" },
      { "x-switcherTitle": "VLESS", "$ref": "#/$defs/outbounds_vless" },
      { "x-switcherTitle": "TUIC", "$ref": "#/$defs/outbounds_tuic" },
      { "x-switcherTitle": "Hysteria2", "$ref": "#/$defs/outbounds_hysteria2" },
      { "x-switcherTitle": "AnyTLS", "$ref": "#/$defs/outbounds_anytls" },
      { "x-switcherTitle": "Tor", "$ref": "#/$defs/outbounds_tor" },
      { "x-switcherTitle": "SSH", "$ref": "#/$defs/outbounds_ssh" },
      { "x-switcherTitle": "DNS", "$ref": "#/$defs/outbounds_dns" },
      { "x-switcherTitle": "Selector", "$ref": "#/$defs/outbounds_selector" },
      { "x-switcherTitle": "URLtest", "$ref": "#/$defs/outbounds_urltest" }
    ]
  }
}
