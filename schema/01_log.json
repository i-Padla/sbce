{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Log",
  "properties": {
    "disabled": {
      "x-format": "toggle",
      "x-enumTitles": ["Disable", "Enable"],
      "type": "boolean",
      "title": "Disable log"
    },
    "level": {
      "x-format": "radios-inline",
      "type": "string",
      "title": "Log level",
      "enum": ["trace", "debug", "info", "warn", "error", "fatal", "panic"],
      "default": "info"
    },
    "output": {
      "type": "string",
      "title": "Output file"
    },
    "timestamp": {
      "x-format": "toggle",
      "x-enumTitles": ["No", "Yes"],
      "type": "boolean",
      "title": "Include timestamp"
    }
  }
}
