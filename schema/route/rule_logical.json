{
  "type": "object",
  "x-switcherTitle": "Logical rule",
  "required": [
    "type",
    "mode",
    "rules"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "logical",
      "default": "logical",
      "readOnly": true
    },
    "action": {
      "type": "string",
      "enum": [
        "route",
        "reject",
        "sniff",
        "hijack-dns",
        "resolve",
        "route-options"
      ]
    },
    "mode": {
      "description": "`and` or `or`",
      "type": "string",
      "enum": [
        "and",
        "or"
      ]
    },
    "rules": {
      "$ref": "#/$defs/route_rules"
    }
  }
}