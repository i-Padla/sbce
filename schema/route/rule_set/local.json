{
  "type": "object",
  "title": "{{ value.tag }} (local)",
  "x-switcherTitle": "Local",
  "required": [
    "type",
    "tag",
    "path"
  ],
  "properties": {
    "type": {
      "type": "string",
      "default": "local",
      "const": "local",
      "readOnly": true
    },
    "tag": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "source",
        "binary"
      ]
    },
    "path": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "url": {
        "not": {
          "pattern": "\\.(json|srs)$"
        }
      }
    }
  },
  "then": {
    "required": [
      "format"
    ]
  }
}