{
  "type": "object",
  "title": "{{ value.tag }} (local)",
  "x-switcherTitle": "Local",
  "required": ["type", "tag", "path"],
  "properties": {
    "type": {
      "type": "string",
      "default": "local",
      "const": "local",
      "readOnly": true
    },
    "tag": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["source", "binary"]
    },
    "path": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "path": {
        "not": {
          "pattern": "\\.(json|srs)$"
        }
      }
    }
  },
  "then": {
    "required": ["format"]
  }
}