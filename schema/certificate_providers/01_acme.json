{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-format": "grid",
  "required": ["type", "domain"],
  "properties": {
    "type": {
      "type": "string",
      "default": "acme",
      "const": "acme",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "",
      "x-grid": {
        "columns": 6
      }
    },
    "domain": {
      "$ref": "#/$defs/string_or_array"
    },
    "data_directory": {
      "type": "string"
    },
    "default_server_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "account_key": {
      "type": "string"
    },
    "disable_http_challenge": {
      "x-format": "toggle",
      "type": "boolean"
    },
    "disable_tls_alpn_challenge": {
      "x-format": "toggle",
      "type": "boolean"
    },
    "alternative_http_port": {
      "type": "integer"
    },
    "alternative_tls_port": {
      "type": "integer"
    },
    "external_account": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string"
        },
        "mac_key": {
          "type": "string"
        }
      }
    },
    "dns01_challenge": {
      "type": "object",
      "description": "Temp placeholder"
    },
    "key_type": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["ed25519", "p256", "p384", "rsa2048", "rsa4096"]
    },
    "profile": {
      "type": "string"
    },
    "http_client": {
      "x-switcherInput": "modal",
      "x-prepared": true,
      "oneOf": [
        {
          "x-switcherTitle": "Tag only",
          "type": "string"
        },
        {
          "x-switcherTitle": "Advanced",
          "$ref": "#/$defs/shared_http_client"
        }
      ]
    }
  }
}
