{
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-enablePropertiesToggle": true,
  "x-propertiesToggleContent": "Toggle properties",
  "x-format": "grid",
  "required": ["type", "address", "private_key", "peers"],
  "properties": {
    "type": {
      "type": "string",
      "default": "wireguard",
      "const": "wireguard",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "wg-in",
      "x-grid": {
        "columns": 6
      }
    },
    "system": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "name": {
      "type": "string"
    },
    "mtu": {
      "type": "integer",
      "default": 1408
    },
    "address": {
      "$ref": "#/$defs/string_or_array"
    },
    "private_key": {
      "type": "string"
    },
    "listen_port": {
      "type": "integer"
    },
    "peers": {
      "type": "array",
      "x-format": "nav-vertical",
      "x-arrayAddContent": "Add",
      "x-arrayMove": false,
      "x-arrayDeleteContent": "",
      "x-arrayDeleteAll": true,
      "x-arrayDeleteAllContent": "Delete all",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "minItems": 1,
      "title": "Peers List",
      "x-titleTemplate": "Peer #{{ i1 }}",
      "items": {
        "type": "object",
        "x-enableCollapseToggle": true,
        "x-collapseToggleContent": "",
        "x-enablePropertiesToggle": true,
        "x-propertiesToggleContent": "Toggle properties",
        "x-format": "grid",
        "title": "Peer #{{ i1 }}",
        "properties": {
          "address": {
            "type": "string",
            "x-grid": {
              "columns": 6
            }
          },
          "port": {
            "type": "integer",
            "x-grid": {
              "columns": 6
            }
          },
          "public_key": {
            "type": "string"
          },
          "pre_shared_key": {
            "type": "string"
          },
          "allowed_ips": {
            "$ref": "#/$defs/string_or_array"
          },
          "persistent_keepalive_interval": {
            "type": "integer"
          },
          "reserved": {
            "type": "array",
            "x-format": "tuple",
            "x-theadHidden": true,
            "x-enableCollapseToggle": true,
            "x-collapseToggleContent": "",
            "x-arrayAdd": false,
            "x-arrayMove": false,
            "x-arrayDelete": false,
            "default": [0, 0, 0],
            "prefixItems": [
              {
                "x-titleHidden": true,
                "type": "integer"
              },
              {
                "x-titleHidden": true,
                "type": "integer"
              },
              {
                "x-titleHidden": true,
                "type": "integer"
              }
            ]
          }
        },
        "required": ["public_key", "allowed_ips"]
      }
    },
    "udp_timeout": {
      "type": "string",
      "default": "5m"
    },
    "workers": {
      "type": "integer",
      "default": 0
    }
  }
}
