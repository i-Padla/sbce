{
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-deactivateNonRequired": true,
  "x-enablePropertiesToggle": true,
  "x-propertiesToggleContent": "Toggle properties",
  "x-format": "grid",
  "required": ["type"],
  "properties": {
    "type": {
      "type": "string",
      "default": "tailscale",
      "const": "tailscale",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "ts-ep",
      "x-grid": {
        "columns": 6
      }
    },
    "state_directory": {
      "type": "string",
      "default": "tailscale"
    },
    "auth_key": {
      "type": "string",
      "default": "ts-ep"
    },
    "control_url": {
      "type": "string",
      "default": "https://controlplane.tailscale.com"
    },
    "ephemeral": {
      "x-format": "toggle",
      "type": "boolean"
    },
    "hostname": {
      "type": "string",
      "default": "ts-ep"
    },
    "accept_routes": {
      "x-format": "toggle",
      "type": "boolean"
    },
    "exit_node": {
      "type": "string",
      "default": "ts-ep"
    },
    "exit_node_allow_lan_access": {
      "x-format": "toggle",
      "type": "boolean"
    },
    "advertise_routes": {
      "$ref": "#/$defs/string_or_array"
    },
    "advertise_exit_node": {
      "x-format": "toggle",
      "type": "boolean"
    },
    "advertise_tags": {
      "$ref": "#/$defs/string_or_array"
    },
    "relay_server_port": {
      "type": "integer"
    },
    "relay_server_static_endpoints": {
      "$ref": "#/$defs/string_or_array"
    },
    "system_interface": {
      "x-format": "toggle",
      "type": "boolean"
    },
    "system_interface_name": {
      "type": "string",
      "default": ""
    },
    "system_interface_mtu": {
      "type": "integer"
    },
    "udp_timeout": {
      "type": "string",
      "default": "5d"
    },
    "ssh_server": {
      "x-switcherInput": "modal",
      "oneOf": [
        {
          "x-switcherTitle": "Short form — boolean",
          "type": "boolean",
          "x-format": "toggle"
        },
        {
          "x-switcherTitle": "Full object form",
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "x-format": "toggle",
              "default": true
            },
            "disable_pty": {
              "type": "boolean",
              "x-format": "toggle"
            },
            "disable_sftp": {
              "type": "boolean",
              "x-format": "toggle"
            },
            "disable_forwarding": {
              "type": "boolean",
              "x-format": "toggle"
            }
          }
        }
      ]
    }
  }
}