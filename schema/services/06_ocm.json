{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-switcherTitle": "OCM",
  "x-format": "grid",
  "required": ["type", "listen"],
  "properties": {
    "type": {
      "type": "string",
      "default": "ocm",
      "const": "ocm",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "x-prepared": true,
      "type": "string",
      "default": "",
      "x-grid": {
        "columns": 6
      }
    },
    "credential_path": {
      "type": "string"
    },
    "usages_path": {
      "type": "string"
    },
    "users": {
      "type": "array",
      "x-format": "nav-vertical",
      "x-arrayAddContent": "Add",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "x-arrayMove": false,
      "x-arrayDeleteContent": "",
      "x-arrayDeleteAll": true,
      "x-arrayDeleteAllContent": "Delete all",
      "x-arrayButtonsPosition": "right",
      "x-titleTemplate": "#{{i1}} {{value.name}}",
      "items": {
        "type": "object",
        "x-enablePropertiesToggle": true,
        "title": "{{value.name}}",
        "x-format": "grid",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string",
            "x-grid": {
              "columns": 6
            }
          },
          "token": {
            "title": "Token",
            "type": "string",
            "x-grid": {
              "columns": 6
            }
          }
        }
      }
    },
    "headers": {
      "type": "object",
      "title": "Headers",
      "x-objectAdd": true,
      "x-addPropertyContent": "Add custom header",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "additionalProperties": {
        "$ref": "#/$defs/string_or_array"
      }
    },
    "detour": {
      "type": "string"
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_inbound"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_listen"
    }
  ]
}
