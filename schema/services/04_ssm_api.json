{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-switcherTitle": "SSM API",
  "x-format": "grid",
  "required": ["type", "servers", "listen"],
  "properties": {
    "type": {
      "type": "string",
      "default": "ssm-api",
      "const": "ssm-api",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "x-prepared": true,
      "type": "string",
      "default": "",
      "x-grid": {
        "x-prepared": true,
        "columns": 6
      }
    },
    "servers": {
      "type": "object",
      "title": "Servers",
      "x-objectAdd": true,
      "x-addPropertyContent": "Add server",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "additionalProperties": {
        "type": "string"
      }
    },
    "cache_path": {
      "type": "string"
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_inbound"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_listen"
    }
  ]
}