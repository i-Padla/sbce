{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-switcherTitle": "DERP",
  "x-format": "grid",
  "required": ["type", "config_path", "listen"],
  "properties": {
    "type": {
      "type": "string",
      "default": "derp",
      "const": "derp",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "x-prepared": true,
      "type": "string",
      "default": "",
      "x-grid": {
        "columns": 6
      }
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_inbound"
    },
    "config_path": {
      "type": "string"
    },
    "verify_client_endpoint": {
      "$ref": "#/$defs/string_or_array"
    },
    "verify_client_url": {
      "type": "array",
      "x-theadHidden": true,
      "x-arrayAddContent": "",
      "x-arrayDelete": true,
      "x-arrayDeleteContent": "",
      "x-arrayDeleteAll": true,
      "x-arrayDeleteAllContent": "Delete all",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "x-arrayMove": false,
      "items": {
        "x-switcherInput": "select-inline",
        "oneOf": [
          {
            "x-titleHidden": true,
            "x-switcherTitle": "URL only",
            "type": "string"
          },
          {
            "x-titleHidden": true,
            "x-switcherTitle": "Advanced",
            "properties": {
              "url": {
                "type": "string"
              }
            },
            "x-mergeAllOf": true,
            "allOf": [{ "$ref": "#/$defs/shared_http_client" }]
          }
        ]
      }
    },
    "home": {
      "type": "string"
    },
    "mesh_with": {
      "type": "array",
      "x-format": "nav-horizontal",
      "x-arrayAddContent": "",
      "x-arrayDelete": true,
      "x-arrayDeleteContent": "",
      "x-arrayDeleteAll": true,
      "x-arrayDeleteAllContent": "Delete all",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "x-arrayMove": false,
      "items": {
        "x-prepared": true,
        "x-switcherInput": "modal",
        "oneOf": [
          {
            "x-switcherTitle": "Tag only",
            "type": "string"
          },
          {
            "x-switcherTitle": "Advanced",
            "$ref": "#/$defs/shared_dial",
            "required": ["server", "server_port"],
            "properties": {
              "server": {
                "type": "string"
              },
              "server_port": {
                "type": "integer"
              },
              "host": {
                "type": "string"
              },
              "tls": {
                "$ref": "#/$defs/shared_tls_outbound"
              }
            }
          }
        ]
      }
    },
    "mesh_psk": {
      "type": "string"
    },
    "mesh_psk_file": {
      "type": "string"
    },
    "stun": {
      "x-prepared": true,
      "x-switcherInput": "modal",
      "oneOf": [
        {
          "x-switcherTitle": "STUN port only",
          "type": "integer"
        },
        {
          "x-switcherTitle": "Advanced",
          "type": "object",
          "required": ["enabled", "listen", "listen_port"],
          "properties": {
            "enabled": {
              "x-format": "toggle",
              "type": "boolean",
              "default": true,
              "readOnly": true
            },
            "listen": {
              "type": "string",
              "x-propGroup": "Shared listen fields",
              "x-grid": {
                "columns": 6,
                "newRow": true
              }
            },
            "listen_port": {
              "type": "integer",
              "x-propGroup": "Shared listen fields",
              "x-grid": {
                "columns": 6
              }
            }
          },
          "x-mergeAllOf": true,
          "allOf": [
            {
              "$ref": "#/$defs/shared_listen"
            }
          ]
        }
      ]
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_listen"
    }
  ]
}
