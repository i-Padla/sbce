{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-switcherTitle": "Resolved",
  "x-format": "grid",
  "required": ["type", "listen", "listen_port"],
  "properties": {
    "type": {
      "type": "string",
      "default": "resolved",
      "const": "resolved",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "",
      "x-grid": {
        "columns": 6
      }
    },
    "listen": {
      "type": "string",
      "x-propGroup": "Shared listen fields",
      "x-grid": {
        "columns": 6,
        "newRow": true
      }
    },
    "listen_port": {
      "type": "integer",
      "x-propGroup": "Shared listen fields",
      "x-grid": {
        "columns": 6
      }
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_listen"
    }
  ]
}