{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-switcherTitle": "Sing-box API",
  "x-format": "grid",
  "required": ["type", "listen"],
  "properties": {
    "type": {
      "type": "string",
      "default": "api",
      "const": "api",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "x-prepared": true,
      "type": "string",
      "default": "",
      "x-grid": {
        "columns": 6
      }
    },
    "secret": {
      "type": "string"
    },
    "access_control_allow_origin": {
      "$ref": "#/$defs/string_or_array"
    },
    "access_control_allow_private_network": {
      "x-format": "toggle",
      "type": "boolean"
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "x-format": "toggle"
        },
        "path": {
          "type": "string"
        },
        "download_url": {
          "type": "string"
        },
        "http_client": {
          "x-switcherInput": "modal",
          "oneOf": [
            {
              "x-switcherTitle": "Tag only",
              "type": "string"
            },
            {
              "x-switcherTitle": "Advanced",
              "$ref": "#/$defs/shared_http_client"
            }
          ]
        },
        "update_interval": {
          "type": "string"
        }
      }
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_inbound"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_listen"
    }
  ]
}
