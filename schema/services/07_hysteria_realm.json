{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Hysteria realm",
  "x-format": "grid",
  "required": [
    "type",
    "listen",
    "users"
  ],
  "properties": {
    "type": {
      "x-propertyOrder": 10,
      "type": "string",
      "default": "hysteria-realm",
      "const": "hysteria-realm",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "x-prepared": true,
      "x-propertyOrder": 20,
      "type": "string",
      "default": "",
      "x-grid": {
        "columns": 6
      }
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_inbound"
    },
    "users": {
      "type": "array",
      "x-format": "nav-vertical",
      "x-arrayAddContent": "Add",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "x-arrayMove": false,
      "x-arrayDeleteContent": "",
      "x-arrayDeleteAll": true,
      "x-arrayDeleteAllContent": "Delete all",
      "x-arrayButtonsPosition": "right",
      "x-titleTemplate": "#{{i1}} {{value.name}}",
      "items": {
        "type": "object",
        "required": [
          "name",
          "token"
        ],
        "x-enablePropertiesToggle": true,
        "title": "{{value.name}}",
        "x-format": "grid",
        "properties": {
          "name": {
            "x-propertieOrder": 10,
            "title": "Name",
            "type": "string",
            "x-grid": {
              "columns": 6
            }
          },
          "token": {
            "x-propertieOrder": 20,
            "title": "Token",
            "type": "string",
            "x-grid": {
              "columns": 6
            }
          },
          "max_realms": {
            "type": "integer"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/shared_http2"
    },
    {
      "$ref": "#/$defs/shared_listen"
    }
  ]
}