{
  "type": "object",
  "title": "Route",
  "x-propertiesToggleContent": "Toggle properties",
  "properties": {
    "rules": {
      "$ref": "#/$defs/route_rules"
    },
    "rule_set": {
      "$ref": "#/$defs/route_rule_set"
    },
    "final": {
      "type": "string"
    },
    "auto_detect_interface": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "override_android_vpn": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "default_interface": {
      "type": "string"
    },
    "default_mark": {
      "type": "integer"
    },
    "find_process": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "find_neighbor": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "dhcp_lease_files": {
      "$ref": "#/$defs/string_or_array"
    },
    "default_http_client": {
      "type": "string"
    },
    "default_domain_resolver": {
      "x-propGroup": "Shared dial fields",
      "x-switcherInput": "modal",
      "oneOf": [
        {
          "x-switcherTitle": "Tag only",
          "type": "string"
        },
        {
          "x-switcherTitle": "Advanced",
          "type": "object",
          "required": ["server"],
          "properties": {
            "server": {
              "type": "string"
            },
            "strategy": {
              "type": "string",
              "x-format": "radios-inline",
              "enum": ["prefer_ipv4", "prefer_ipv6", "ipv4_only", "ipv6_only"]
            },
            "disable_cache": {
              "type": "boolean",
              "x-format": "toggle"
            },
            "disable_optimistic_cache": {
              "type": "boolean",
              "x-format": "toggle"
            },
            "rewrite_ttl": {
              "type": "integer"
            },
            "timeout": {
              "type": "string"
            },
            "client_subnet": {
              "type": "string"
            }
          }
        }
      ]
    },
    "default_network_strategy": {
      "type": "string"
    },
    "default_network_type": {
      "x-format": "checkboxes-scalar",
      "oneOf": [
        {
          "type": "array",
          "x-propGroup": "Shared dial fields",
          "items": {
            "type": "string",
            "enum": ["wifi", "cellular", "ethernet", "other"]
          }
        },
        {
          "type": "string",
          "enum": ["wifi", "cellular", "ethernet", "other"]
        }
      ]
    },
    "default_fallback_network_type": {
      "x-format": "checkboxes-scalar",
      "oneOf": [
        {
          "type": "array",
          "x-propGroup": "Shared dial fields",
          "items": {
            "type": "string",
            "enum": ["wifi", "cellular", "ethernet", "other"]
          }
        },
        {
          "type": "string",
          "enum": ["wifi", "cellular", "ethernet", "other"]
        }
      ]
    },
    "default_fallback_delay": {
      "type": "string"
    }
  }
}
