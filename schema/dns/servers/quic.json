{
    "type": "object",
    "title": "Quic",
    "x-format": "grid",
    "properties": {
        "type": {
            "type": "string",
            "default": "quic",
            "const": "quic",
            "readOnly": true,
            "x-grid": {
                "columns": 6
            }
        },
        "tag": {
            "type": "string",
            "default": "quic-dns",
            "x-grid": {
                "columns": 6
            }
        },
        "server": {
            "type": "string",
            "x-grid": {
                "columns": 6
            }
        },
        "server_port": {
            "type": "integer",
            "default": 853,
            "x-grid": {
                "columns": 6
            }
        },
        "tls": {
            "type": "object",
            "title": "TLS Settings",
            "x-enableCollapseToggle": true,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "title": "Enable TLS"
                },
                "server_name": {
                    "type": "string",
                    "title": "Server Name (SNI)",
                    "default": "dns.google"
                },
                "insecure": {
                    "type": "boolean",
                    "title": "Allow Insecure"
                }
            }
        }
    },
    "required": [
        "type",
        "tag"
    ]
}