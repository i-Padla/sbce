{
    "type": "object",
    "title": "HTTPS",
    "x-format": "grid",
    "required": [
        "type",
        "tag",
        "server"
    ],
    "properties": {
        "type": {
            "type": "string",
            "default": "https",
            "const": "https",
            "readOnly": true,
            "x-grid": {
                "columns": 6
            }
        },
        "tag": {
            "type": "string",
            "default": "https-dns",
            "x-grid": {
                "columns": 6
            }
        },
        "server": {
            "type": "string",
            "title": "Server",
            "x-grid": {
                "columns": 6
            }
        },
        "server_port": {
            "type": "integer",
            "title": "Port",
            "default": 853,
            "x-grid": {
                "columns": 6
            }
        },
        "path": {
            "type": "string",
            "title": "Path"
        },
        "tls": {
            "$ref": "#/$defs/shared_tls_inbound"
        },
        "headers": {
            "$ref": "#/$defs/shared_http_headers"
        }
    },
    "$ref": "#/$defs/shared_dial"
}