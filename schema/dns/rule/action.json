{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "",
        "route",
        "evaluate",
        "respond",
        "route-options",
        "reject",
        "predefined"
      ]
    },
    "server": {
      "type": "string"
    },
    "strategy": {
      "type": "string",
      "enum": [
        "prefer_ipv4",
        "prefer_ipv6",
        "ipv4_only",
        "ipv6_only"
      ]
    },
    "disable_cache": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "disable_optimistic_cache": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "rewrite_ttl": {
      "type": "integer"
    },
    "timeout": {
      "type": "string"
    },
    "client_subnet": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "enum": [
        "default",
        "drop"
      ]
    },
    "no_drop": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "rcode": {
      "type": "string",
      "enum": [
        "NOERROR",
        "FORMERR",
        "SERVFAIL",
        "NXDOMAIN",
        "NOTIMP",
        "REFUSED"
      ]
    },
    "answer": {
      "$ref": "#/$defs/string_or_array"
    },
    "ns": {
      "$ref": "#/$defs/string_or_array"
    },
    "extra": {
      "$ref": "#/$defs/string_or_array"
    }
  }
}