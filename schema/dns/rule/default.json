{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "x-enableCollapseToggle": true,
  "x-collapseToggleContent": "",
  "x-switcherTitle": "Default",
  "properties": {
    "type": {
      "type": "string",
      "const": "default",
      "default": "default",
      "readOnly": true
    },
    "inbound": {
      "$ref": "#/$defs/string_or_array"
    },
    "ip_version": {
      "type": "integer",
      "x-format": "radios-inline",
      "enum": [4, 6]
    },
    "query_type": {
      "$ref": "#/$defs/string_or_array"
    },
    "network": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["tcp", "udp", "icmp"]
    },
    "auth_user": {
      "$ref": "#/$defs/string_or_array"
    },
    "protocol": {
      "x-format": "checkboxes-scalar",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "http",
              "tls",
              "quic",
              "stun",
              "dns",
              "bittorrent",
              "dtls",
              "ssh",
              "rdp",
              "ntp"
            ]
          }
        },
        {
          "type": "string",
          "enum": [
            "http",
            "tls",
            "quic",
            "stun",
            "dns",
            "bittorrent",
            "dtls",
            "ssh",
            "rdp",
            "ntp"
          ]
        }
      ]
    },
    "domain": {
      "$ref": "#/$defs/string_or_array"
    },
    "domain_suffix": {
      "$ref": "#/$defs/string_or_array"
    },
    "domain_keyword": {
      "$ref": "#/$defs/string_or_array"
    },
    "domain_regex": {
      "$ref": "#/$defs/string_or_array"
    },
    "source_ip_cidr": {
      "$ref": "#/$defs/string_or_array"
    },
    "source_ip_is_private": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "source_port": {
      "$ref": "#/$defs/integer_or_array"
    },
    "source_port_range": {
      "$ref": "#/$defs/string_or_array"
    },
    "port": {
      "$ref": "#/$defs/integer_or_array"
    },
    "port_range": {
      "$ref": "#/$defs/string_or_array"
    },
    "process_name": {
      "$ref": "#/$defs/string_or_array"
    },
    "process_path": {
      "$ref": "#/$defs/string_or_array"
    },
    "process_path_regex": {
      "$ref": "#/$defs/string_or_array"
    },
    "package_name": {
      "$ref": "#/$defs/string_or_array"
    },
    "package_name_regex": {
      "$ref": "#/$defs/string_or_array"
    },
    "user": {
      "$ref": "#/$defs/string_or_array"
    },
    "user_id": {
      "$ref": "#/$defs/integer_or_array"
    },
    "clash_mode": {
      "type": "string"
    },
    "network_type": {
      "x-format": "checkboxes-scalar",
      "oneOf": [
        {
          "type": "array",
          "x-propGroup": "Shared dial fields",
          "items": {
            "type": "string",
            "enum": ["wifi", "cellular", "ethernet", "other"]
          }
        },
        {
          "type": "string",
          "enum": ["wifi", "cellular", "ethernet", "other"]
        }
      ]
    },
    "network_is_expensive": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "network_is_constrained": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "interface_address": {
      "type": "object",
      "x-objectAdd": true,
      "x-enablePropertiesToggle": true
    },
    "network_interface_address": {
      "type": "object",
      "x-objectAdd": true,
      "x-enablePropertiesToggle": true
    },
    "default_interface_address": {
      "$ref": "#/$defs/string_or_array"
    },
    "source_mac_address": {
      "$ref": "#/$defs/string_or_array"
    },
    "source_hostname": {
      "$ref": "#/$defs/string_or_array"
    },
    "preferred_by": {
      "x-format": "checkboxes-scalar",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["host", "local", "mdns", "tailscale", "resolved"]
          }
        },
        {
          "type": "string",
          "enum": ["host", "local", "mdns", "tailscale", "resolved"]
        }
      ]
    },
    "wifi_ssid": {
      "$ref": "#/$defs/string_or_array"
    },
    "wifi_bssid": {
      "$ref": "#/$defs/string_or_array"
    },
    "rule_set": {
      "$ref": "#/$defs/string_or_array"
    },
    "rule_set_ip_cidr_match_source": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "match_response": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "ip_cidr": {
      "$ref": "#/$defs/string_or_array"
    },
    "ip_is_private": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "ip_accept_any": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "response_rcode": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": [
        "NOERROR",
        "FORMERR",
        "SERVFAIL",
        "NXDOMAIN",
        "NOTIMP",
        "REFUSED"
      ]
    },
    "response_answer": {
      "$ref": "#/$defs/string_or_array"
    },
    "response_ns": {
      "$ref": "#/$defs/string_or_array"
    },
    "response_extra": {
      "$ref": "#/$defs/string_or_array"
    },
    "invert": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "geosite": {
      "$ref": "#/$defs/string_or_array",
      "x-propGroup": "Deprecated"
    },
    "source_geoip": {
      "$ref": "#/$defs/string_or_array",
      "x-propGroup": "Deprecated"
    },
    "rule_set_ipcidr_match_source": {
      "$ref": "#/$defs/string_or_array",
      "x-propGroup": "Deprecated"
    },
    "server": {
      "$ref": "#/$defs/string_or_array",
      "x-propGroup": "Deprecated"
    },
    "disable_cache": {
      "type": "boolean",
      "x-format": "toggle",
      "x-propGroup": "Deprecated"
    },
    "rewrite_ttl": {
      "x-propGroup": "Deprecated",
      "type": "integer"
    },
    "client_subnet": {
      "type": "string",
      "x-propGroup": "Deprecated"
    },
    "geoip": {
      "$ref": "#/$defs/string_or_array",
      "x-propGroup": "Deprecated"
    },
    "rule_set_ip_cidr_accept_empty": {
      "type": "boolean",
      "x-format": "toggle",
      "x-propGroup": "Deprecated"
    },
    "outbound": {
      "type": "string",
      "x-propGroup": "Deprecated"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/dns_rule_action"
    }
  ]
}
