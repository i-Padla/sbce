{
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-format": "grid",
  "required": ["type", "token", "listen"],
  "properties": {
    "type": {
      "type": "string",
      "default": "cloudflared",
      "const": "cloudflared",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "cloudflared-in",
      "x-grid": {
        "columns": 6
      }
    },
    "token": {
      "type": "string"
    },
    "ha_connections": {
      "type": "integer",
      "x-grid": {
        "columns": 6
      }
    },
    "protocol": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["quic", "hhtp2"],
      "x-grid": {
        "columns": 6
      }
    },
    "post_quantum": {
      "x-format": "toggle",
      "type": "boolean"
    },
    "edge_ip_version": {
      "type": "integer",
      "x-format": "radios-inline",
      "enum": [0, 4, 6],
      "x-grid": {
        "columns": 6
      }
    },
    "datagram_version": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["v2", "v3"],
      "x-grid": {
        "columns": 6
      }
    },
    "grace_period": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "region": {
      "type": "string",
      "x-grid": {
        "columns": 6
      }
    },
    "control_dialer": {
      "$ref": "#/$defs/shared_dial"
    },
    "tunnel_dialer": {
      "$ref": "#/$defs/shared_dial"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_listen"
    }
  ]
}