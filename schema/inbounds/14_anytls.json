{
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-format": "grid",
  "required": ["type", "listen"],
  "properties": {
    "type": {
      "type": "string",
      "default": "anytls",
      "const": "anytls",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "anytls-in",
      "x-grid": {
        "columns": 6
      }
    },
    "users": {
      "type": "array",
      "x-format": "table-object",
      "x-arrayAddContent": "Add",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "x-arrayMove": false,
      "x-arrayDeleteContent": "",
      "x-arrayDeleteAll": true,
      "x-arrayDeleteAllContent": "Delete all",
      "x-arrayButtonsPosition": "right",
      "items": {
        "type": "object",
        "x-enablePropertiesToggle": false,
        "required": ["name", "password"],
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        }
      }
    },
    "padding_scheme": {
      "default": [
        "stop=8",
        "0=30-30",
        "1=100-400",
        "2=400-500,c,500-1000,c,500-1000,c,500-1000,c,500-1000",
        "3=9-9,500-1000",
        "4=500-1000",
        "5=500-1000",
        "6=500-1000",
        "7=500-1000"
      ],
      "$ref": "#/$defs/string_or_array"
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_inbound"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_listen"
    }
  ]
}