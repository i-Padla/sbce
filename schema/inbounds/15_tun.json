{
  "type": "object",
  "title": "Tun",
  "x-format": "grid",
  "required": ["type"],
  "x-prepaed": ["tag"],
  "properties": {
    "type": {
      "x-propertyOrder": 10,
      "type": "string",
      "default": "tun",
      "const": "tun",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "x-propertyOrder": 20,
      "type": "string",
      "default": "tun_in",
      "x-grid": {
        "columns": 6
      }
    },
    "interface_name": {
      "type": "string"
    },
    "address": {
      "$ref": "#/$defs/string_or_array"
    },
    "mtu": {
      "type": "integer",
      "default": 9000
    },
    "dns_mode": {
      "type": "string",
      "enum": ["hijack", "native", "disabled"]
    },
    "dns_address": {
      "$ref": "#/$defs/string_or_array"
    },
    "auto_route": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "iproute2_table_index": {
      "type": "integer",
      "default": 2022
    },
    "iproute2_rule_index": {
      "type": "integer",
      "default": 9000
    },
    "auto_redirect": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "auto_redirect_input_mark": {
      "type": "string",
      "default": "0x2023"
    },
    "auto_redirect_output_mark": {
      "type": "string",
      "default": "0x2024"
    },
    "auto_redirect_reset_mark": {
      "type": "string",
      "default": "0x2025"
    },
    "auto_redirect_nfqueue": {
      "type": "integer",
      "default": 100
    },
    "auto_redirect_iproute2_fallback_rule_index": {
      "type": "integer",
      "default": 327668
    },
    "exclude_mptcp": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "loopback_address": {
      "$ref": "#/$defs/string_or_array"
    },
    "strict_route": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "route_address": {
      "$ref": "#/$defs/string_or_array",
      "default": ["0.0.0.0/1", "128.0.0.0/1", "::/1", "8000::/1"]
    },
    "route_exclude_address": {
      "$ref": "#/$defs/string_or_array",
      "default": ["192.168.0.0/16", "fc00::/7"]
    },
    "route_address_set": {
      "$ref": "#/$defs/string_or_array"
    },
    "route_exclude_address_set": {
      "$ref": "#/$defs/string_or_array"
    },
    "endpoint_independent_nat": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "udp_timeout": {
      "type": "string",
      "default": "5m"
    },
    "stack": {
      "type": "string",
      "default": "system"
    },
    "include_interface": {
      "$ref": "#/$defs/string_or_array"
    },
    "exclude_interface": {
      "$ref": "#/$defs/string_or_array"
    },
    "include_uid": {
      "type": "array",
      "x-format": "table",
      "x-arrayDeleteContent": "",
      "x-arrayAddContent": "Add",
      "x-arrayMove": false,
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "items": {
        "type": "integer"
      }
    },
    "include_uid_range": {
      "$ref": "#/$defs/string_or_array"
    },
    "exclude_uid": {
      "type": "array",
      "x-format": "table",
      "x-arrayDeleteContent": "",
      "x-arrayAddContent": "Add",
      "x-arrayMove": false,
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "items": {
        "type": "integer"
      }
    },
    "exclude_uid_range": {
      "$ref": "#/$defs/string_or_array"
    },
    "include_android_user": {
      "type": "array",
      "x-format": "table",
      "x-arrayDeleteContent": "",
      "x-arrayAddContent": "Add",
      "x-arrayMove": false,
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "items": {
        "type": "integer"
      }
    },
    "include_package": {
      "$ref": "#/$defs/string_or_array"
    },
    "exclude_package": {
      "$ref": "#/$defs/string_or_array"
    },
    "include_mac_address": {
      "$ref": "#/$defs/string_or_array"
    },
    "exclude_mac_address": {
      "$ref": "#/$defs/string_or_array"
    },
    "platform": {
      "type": "object",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "properties": {
        "http_proxy": {
          "type": "object",
          "x-enableCollapseToggle": true,
          "x-collapseToggleContent": "",
          "x-format": "grid",
          "properties": {
            "enabled": {
              "type": "boolean",
              "x-format": "toggle"
            },
            "server": {
              "type": "string",
              "x-grid": {
                "columns": 6
              }
            },
            "server_port": {
              "type": "integer",
              "x-grid": {
                "columns": 6
              }
            },
            "bypass_domain": {
              "$ref": "#/$defs/string_or_array"
            },
            "match_domain": {
              "$ref": "#/$defs/string_or_array"
            }
          }
        }
      }
    },
    "gso": {
      "type": "boolean",
      "x-format": "toggle",
      "x-propGroup": "Depricated"
    },
    "inet4_address": {
      "$ref": "#/$defs/string_or_array",
      "x-propGroup": "Depricated"
    },
    "inet6_address": {
      "$ref": "#/$defs/string_or_array",
      "x-propGroup": "Depricated"
    },
    "inet4_route_address": {
      "$ref": "#/$defs/string_or_array",
      "x-propGroup": "Depricated"
    },
    "inet6_route_address": {
      "$ref": "#/$defs/string_or_array",
      "x-propGroup": "Depricated"
    },
    "inet4_route_exclude_address": {
      "$ref": "#/$defs/string_or_array",
      "x-propGroup": "Depricated"
    },
    "inet6_route_exclude_address": {
      "$ref": "#/$defs/string_or_array",
      "x-propGroup": "Depricated"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_listen"
    }
  ]
}