{
  "type": "object",
  "title": "Naive",
  "x-format": "grid",
  "required": ["type", "users", "listen"],
  "x-prepaed": ["tag"],
  "properties": {
    "type": {
      "x-propertyOrder": 10,
      "type": "string",
      "default": "naive",
      "const": "naive",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "x-propertyOrder": 20,
      "type": "string",
      "default": "naive-in",
      "x-grid": {
        "columns": 6
      }
    },
    "network": {
      "type": "string",
      "enum": ["", "tcp", "udp"]
    },
    "users": {
      "description": "Multi-user configuration.",
      "type": "array",
      "x-format": "nav-vertical",
      "x-arrayAddContent": "Add",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "x-arrayMove": false,
      "x-arrayDeleteContent": "",
      "x-arrayDeleteAll": true,
      "x-arrayDeleteAllContent": "Delete all",
      "x-titleTemplate": "User #{{i1}} - {{ value.name }}",
      "items": {
        "type": "object",
        "title": "User #{{i1}} - {{ value.name }}",
        "x-enablePropertiesToggle": false,
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      }
    },
    "quic_congestion_control": {
      "type": "string",
      "enum": [
        "",
        "bbr",
        "bbr_standard",
        "bbr2",
        "bbr2_variant",
        "cubic",
        "reno"
      ]
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_inbound"
    }
  },
  "$ref": "#/$defs/shared_listen"
}
