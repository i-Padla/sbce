{
  "type": "object",
  "title": "VLESS",
  "x-format": "grid",
  "required": [
    "type",
    "listen"
  ],
  "x-prepaed": [
    "tag"
  ],
  "properties": {
    "type": {
      "x-propertyOrder": 10,
      "type": "string",
      "default": "vless",
      "const": "vless",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "x-propertyOrder": 20,
      "type": "string",
      "default": "VLESS_in",
      "x-grid": {
        "columns": 6
      }
    },
    "users": {
      "type": "array",
      "x-format": "nav-vertical",
      "x-arrayAddContent": "Add",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "x-arrayMove": false,
      "x-arrayDeleteContent": "",
      "x-arrayDeleteAll": true,
      "x-arrayDeleteAllContent": "Delete all",
      "x-arrayButtonsPosition": "right",
      "x-titleTemplate": "{{value.name}}",
      "items": {
        "type": "object",
        "title": "{{value.name}}",
        "x-enablePropertiesToggle": true,
        "x-format": "grid",
        "required": [
          "uuid"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "uuid": {
            "type": "string"
          },
          "flow": {
            "type": "string",
            "enum": [
              "xtls-rprx-vision"
            ]
          }
        }
      }
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_inbound"
    },
    "multiplex": {
      "$ref": "#/$defs/shared_multiplex_inbound"
    },
    "transport": {
      "$ref": "#/$defs/shared_v2ray_transport"
    }
  },
  "$ref": "#/$defs/shared_listen"
}