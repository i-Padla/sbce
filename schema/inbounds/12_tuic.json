{
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-format": "grid",
  "required": ["type", "tls", "listen"],
  "properties": {
    "type": {
      "type": "string",
      "default": "tuic",
      "const": "tuic",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "tuic-in",
      "x-grid": {
        "columns": 6
      }
    },
    "users": {
      "type": "array",
      "x-format": "nav-vertical",
      "x-arrayAddContent": "Add",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "x-arrayMove": false,
      "x-arrayDeleteContent": "",
      "x-arrayDeleteAll": true,
      "x-arrayDeleteAllContent": "Delete all",
      "x-arrayButtonsPosition": "right",
      "x-titleTemplate": "#{{i1}} {{value.name}}",
      "items": {
        "type": "object",
        "title": "#{{i1}} {{value.name}}",
        "x-enablePropertiesToggle": true,
        "x-format": "grid",
        "required": ["uuid"],
        "properties": {
          "name": {
            "type": "string"
          },
          "uuid": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      }
    },
    "congestion_control": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["cubic", "new_reno", "bbr"]
    },
    "auth_timeout": {
      "type": "string"
    },
    "zero_rtt_handshake": {
      "type": "boolean"
    },
    "heartbeat": {
      "type": "string"
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_inbound"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_listen"
    },
    {
      "$ref": "#/$defs/shared_quic"
    }
  ]
}
