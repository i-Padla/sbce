{
  "type": "object",
  "title": "Shadowsocks",
  "x-format": "grid",
  "required": ["type", "listen", "password"],
  "properties": {
    "type": {
      "type": "string",
      "default": "shadowsocks",
      "const": "shadowsocks",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "ss-in",
      "x-grid": {
        "columns": 6
      }
    },
    "network": {
      "type": "string",
      "x-format": "radios-inline",
      "enum": ["tcp", "udp"]
    },
    "method": {
      "type": "string",
      "enum": [
        "2022-blake3-aes-128-gcm",
        "2022-blake3-aes-256-gcm",
        "2022-blake3-chacha20-poly1305",
        "none",
        "aes-128-gcm",
        "aes-192-gcm",
        "aes-256-gcm",
        "chacha20-ietf-poly1305",
        "xchacha20-ietf-poly1305"
      ]
    },
    "password": {
      "type": "string"
    },
    "users": {
      "type": "array",
      "x-format": "nav-vertical",
      "x-arrayAddContent": "Add",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "x-arrayMove": false,
      "x-arrayDeleteContent": "",
      "x-arrayDeleteAll": true,
      "x-arrayDeleteAllContent": "Delete all",
      "x-titleTemplate": "User #{{i1}} - {{ value.name }}",
      "items": {
        "type": "object",
        "title": "User #{{i1}} - {{ value.name }}",
        "x-enablePropertiesToggle": false,
        "required": ["name", "password"],
        "properties": {
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      }
    },
    "destinations": {
      "type": "array",
      "x-format": "nav-vertical",
      "x-arrayAddContent": "Add",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "x-arrayMove": false,
      "x-arrayDeleteContent": "",
      "x-arrayDeleteAll": true,
      "x-arrayDeleteAllContent": "Delete all",
      "x-titleTemplate": "{{ i1 }}) {{ value.name }}",
      "items": {
        "type": "object",
        "required": ["name", "server", "server_port", "password"],
        "properties": {
          "name": {
            "type": "string"
          },
          "server": {
            "type": "string"
          },
          "server_port": {
            "type": "integer"
          },
          "password": {
            "type": "string"
          }
        }
      }
    },
    "managed": {
      "type": "boolean",
      "x-format": "toggle"
    },
    "multiplex": {
      "$ref": "#/$defs/shared_multiplex_inbound"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_listen"
    }
  ]
}