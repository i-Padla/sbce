{
  "type": "object",
  "title": "#{{i1}} {{value.tag}}",
  "x-format": "grid",
  "required": ["type", "listen"],
  "properties": {
    "type": {
      "type": "string",
      "default": "http",
      "const": "http",
      "readOnly": true,
      "x-grid": {
        "columns": 6
      }
    },
    "tag": {
      "type": "string",
      "default": "http-in",
      "x-grid": {
        "columns": 6
      }
    },
    "users": {
      "type": "array",
      "x-format": "table-object",
      "x-arrayAddContent": "Add",
      "x-enableCollapseToggle": true,
      "x-collapseToggleContent": "",
      "x-arrayMove": false,
      "x-arrayDeleteContent": "",
      "x-arrayDeleteAll": true,
      "x-arrayDeleteAllContent": "Delete all",
      "x-arrayButtonsPosition": "right",
      "items": {
        "type": "object",
        "x-enablePropertiesToggle": false,
        "required": ["name", "password"],
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        }
      }
    },
    "tls": {
      "$ref": "#/$defs/shared_tls_inbound"
    },
    "set_system_proxy": {
      "x-format": "toggle",
      "type": "boolean"
    }
  },
  "x-mergeAllOf": true,
  "allOf": [
    {
      "$ref": "#/$defs/shared_listen"
    }
  ]
}