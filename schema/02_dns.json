{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "DNS",
  "properties": {
    "servers": {
      "$ref": "#/$defs/dns_servers"
    },
    "rules": {
      "$ref": "#/$defs/dns_rule"
    },
    "final": {
      "type": "string",
      "title": "Final Server"
    },
    "strategy": {
      "type": "string",
      "enum": [
        "prefer_ipv4",
        "prefer_ipv6",
        "ipv4_only",
        "ipv6_only"
      ]
    },
    "disable_cache": {
      "x-format": "toggle",
      "type": "boolean"
    },
    "disable_expire": {
      "x-format": "toggle",
      "type": "boolean"
    },
    "independent_cache": {
      "x-format": "toggle",
      "type": "boolean",
      "x-propGroup": "Deprecated"
    },
    "cache_capacity": {
      "type": "integer",
      "title": "LRU cache capacity."
    },
    "optimistic": {
      "type": "object",
      "properties": {
        "enabled": {
          "x-format": "toggle",
          "type": "boolean"
        },
        "timeout": {
          "type": "string"
        }
      }
    },
    "timeout": {
      "type": "string"
    },
    "reverse_mapping": {
      "x-format": "toggle",
      "type": "boolean"
    },
    "client_subnet": {
      "description": "",
      "type": "string"
    }
  }
}